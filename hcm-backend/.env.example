# ============================================================
# DATABASE CONNECTION (MySQL / XAMPP / Railway)
# ============================================================

# --- LIVE PRODUCTION (Railway Cloud MySQL Database) ---
# DATABASE_URL="mysql://root:password@host:port/database"

# --- LOCAL XAMPP MySQL Database (Fallback) ---
DATABASE_URL="mysql://root:@127.0.0.1:3306/hcm_db"

JWT_SECRET=your_super_secret_jwt_key_here

# Server Port
PORT=5001

# Frontend URL
CLIENT_URL=http://localhost:5173

# AI Server & API Credentials
AI_SERVER_URL=http://localhost:4000
OPENAI_API_KEY="your-openai-api-key-here"
PINECONE_API_KEY="your-pinecone-api-key-here"
PINECONE_INDEX=hcm-enterprise
PINECONE_ENVIRONMENT=us-east-1

# Cloudinary (Images: avatars, logos, profile photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ImageKit (Documents: resumes, PDFs, proofs)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint
